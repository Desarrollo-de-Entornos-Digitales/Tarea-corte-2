				{
					"name": "Login admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
									"if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json().access_token); }",
									"if (pm.response.code === 200) { pm.collectionVariables.set('adminUserId', pm.response.json().user.id); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"auth": {
